diff --git a/crates/pingkit/src/samples.rs b/crates/pingkit/src/samples.rs
index 89353ed..0a1a95c 100644
--- a/crates/pingkit/src/samples.rs
+++ b/crates/pingkit/src/samples.rs
@@ -52,6 +52,13 @@ impl SampleLog {
         if let Some(slot) = self.buf.get_mut(self.len) {
             *slot = pack(seg1, seg2, t2);
             self.len += 1;
+            // 实验：提前把下一条缓存行以"可写"状态取进来（8 个样本之后才会写到它），
+            // 这样写样本时不会有一次等内存的写入挂在 CPU 的写入队列里。地址越界也无妨：预取不会出错。
+            #[allow(unused_unsafe)]
+            unsafe {
+                use core::arch::x86_64::{_mm_prefetch, _MM_HINT_ET0};
+                _mm_prefetch::<_MM_HINT_ET0>(self.buf.as_ptr().wrapping_add(self.len + 8) as *const i8);
+            }
         }
     }
 
