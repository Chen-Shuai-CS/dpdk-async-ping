+    /// 实验（fire1）：只触发一个到期的 timer；返回是否唤醒了一个 task。
+    #[inline]
+    pub(crate) fn fire_one(&mut self, now: u64) -> bool {
+        while let Some((_, idx)) = self.heap.pop_expired(now) {
+            match std::mem::replace(&mut self.slots[idx as usize], Slot::Fired(now)) {
+                Slot::Pending(w) => {
+                    w.wake();
+                    return true;
+                }
+                Slot::Cancelled => self.release(idx),
+                other => self.slots[idx as usize] = other,
+            }
+        }
+        false
+    }
+
